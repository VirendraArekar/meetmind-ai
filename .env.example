# =============================================================================
# MeetMind AI - Environment Configuration Template
# Copy this file to .env and fill in real values. Never commit .env files.
# =============================================================================

# Application
APP_ENV=development
APP_NAME=MeetMind AI
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=meetmind
POSTGRES_USER=meetmind
POSTGRES_PASSWORD=change_me_in_production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3-Compatible Object Storage (MinIO locally / AWS S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=meetmind-recordings
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_change_me

# JWT Authentication (Generate a 256-bit+ base64 secret for production)
JWT_SECRET=replace_with_a_secure_256_bit_base64_secret_key_for_local_dev_only
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# AI Providers (Interchangeable Architecture)
AI_TRANSCRIPTION_PROVIDER=openai
AI_LLM_PROVIDER=openai
AI_EMBEDDING_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Local Ollama (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Frontend (Vite)
VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=http://localhost:8080
